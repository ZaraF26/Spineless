{
  "name": "ReadingSession",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string",
      "required": true
    },
    "book_title": {
      "type": "string"
    },
    "book_author": {
      "type": "string"
    },
    "book_cover": {
      "type": "string"
    },
    "book_description": {
      "type": "string"
    },
    "book_file_url": {
      "type": "string"
    },
    "book_file_type": {
      "type": "string",
      "enum": [
        "epub",
        "pdf"
      ],
      "default": "epub"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "planned_finish_date": {
      "type": "string",
      "format": "date"
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ended"
      ],
      "default": "active"
    },
    "description": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "member_count": {
      "type": "number",
      "default": 1
    },
    "member_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          }
        }
      }
    },
    "creator_name": {
      "type": "string"
    },
    "creator_username": {
      "type": "string"
    },
    "creator_avatar": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "required": []
}