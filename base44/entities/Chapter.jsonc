{
  "name": "Chapter",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "required": true
    },
    "number": {
      "type": "number",
      "required": true
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}