{
  "name": "Review",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string",
      "required": true
    },
    "book_title": {
      "type": "string"
    },
    "book_author": {
      "type": "string"
    },
    "book_cover": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "text": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_username": {
      "type": "string"
    },
    "reviewer_avatar": {
      "type": "string"
    }
  },
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}