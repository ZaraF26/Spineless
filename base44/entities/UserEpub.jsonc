{
  "name": "UserEpub",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "required": true
    },
    "author": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "required": true
    },
    "cfi": {
      "type": "string"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "last_read_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "required": []
}