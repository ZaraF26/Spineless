{
  "name": "Book",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "required": true
    },
    "author": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "isbn": {
      "type": "string"
    },
    "external_id": {
      "type": "string"
    },
    "publication_date": {
      "type": "string"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "page_count": {
      "type": "number"
    },
    "cover_color": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "google",
        "manual"
      ],
      "default": "manual"
    }
  },
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}